# Chrome Remote Debugging URL
CHROME_CDP_URL=http://localhost:9222

# Free Delivery Threshold (INR)
FREE_DELIVERY_THRESHOLD=99

# Default Payment Mode: cod, upi, or wallet
DEFAULT_PAYMENT_MODE=cod

# Optional UPI ID for UPI payment collect requests
UPI_ID=yourname@upi

# Target delivery address tag (e.g., WORK or HOME)
ADDRESS_TAG=WORK
